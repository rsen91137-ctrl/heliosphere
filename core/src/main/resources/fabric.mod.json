  "entrypoints": {
    "main": [
      "com.heliosphere.core.Heliosphere"
    ],
    "client": [
      "com.heliosphere.core.client.HeliosphereClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "heliosphere.mixins.json"
  ]
